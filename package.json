{
  "name": "rotem-adani-salon",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:preview": "tsc -b && vite build --mode demo --base ./ --outDir dist-demo",
    "preview": "vite preview",
    "test": "vitest run",
    "test:db": "vitest run tests/db",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "typecheck": "tsc -b",
    "deploy": "npm run build && wrangler pages deploy dist --project-name rotem-adani --branch main"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "pg": "^8.23.1",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9",
    "wrangler": "^4.160.0"
  }
}
